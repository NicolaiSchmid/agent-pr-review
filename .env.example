# Direct Anthropic BYOK. No AI gateway or proxy is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

# Host-only mutation credential. Never injected into the sandbox.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=

# Optional read-only credential held by the host and injected by the sandbox
# firewall only into HTTPS requests to github.com. It never enters process env.
# It should have Contents: read for NicolaiSchmid/nunc-immo and no writes.
GITHUB_SANDBOX_TOKEN=

# Fork PR code is inspected statically by default, but never executed.
ALLOW_FORK_EXECUTION=false

# Hard limits for publication.
MAX_FINDINGS=12
MAX_REVIEW_ROUNDS=3
MAX_REVIEW_CHANGE_BYTES=20000
GITHUB_API_URL=https://api.github.com
